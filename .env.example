# Copy to .env (gitignored) and fill in. Consumed by compose/docker-compose.yml
# and by scripts/*.sh.

# ------------------------------------------------------------------ vLLM ---
# 16 GB VRAM (RTX 4060 Ti) -> Qwen3-14B-AWQ. See docs/RECON.md §1.
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
VLLM_MODEL_ID=Qwen/Qwen3-14B-AWQ
VLLM_TOOL_PARSER=hermes
VLLM_REASONING_PARSER=qwen3
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_UTIL=0.90
# fp8 halves KV cache memory so a 14B AWQ model fits a 32k context in 16 GB.
# Set to 'auto' (and VLLM_MAX_MODEL_LEN=24576) if it costs too much quality.
VLLM_KV_CACHE_DTYPE=fp8
# WARNING: must not contain "o<digit>" or "gpt-5" — OpenSRE switches to
# max_completion_tokens by regex on the model NAME and vLLM rejects it.
# See docs/RECON.md §14.1.
VLLM_SERVED_NAME=opensre-reasoning
# Only needed for gated models on Hugging Face.
HF_TOKEN=

# ------------------------------------------------------------ Mattermost ---
MM_DB_PASSWORD=change-me-locally
MM_ADMIN_EMAIL=admin@example.invalid
MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=change-me-locally-Aa1!
MM_TEAM=sre
MM_CHANNEL=sre-incidents
# Filled in by scripts/mattermost-bootstrap.sh:
MATTERMOST_WEBHOOK_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_DEFAULT_CHANNEL_ID=
MATTERMOST_SLASH_TOKEN=

# --------------------------------------------------------------- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me-locally
# Filled in by scripts/grafana-bootstrap.sh (service account, Viewer role):
GRAFANA_READ_TOKEN=

# ------------------------------------------------------------ Open WebUI ---
# Second endpoint is added in POC phase 5, once the OpenAI-compatible surface
# exists:  http://opensre-control-plane:30080/v1
OPENWEBUI_API_BASES=http://vllm:8000/v1
OPENWEBUI_API_KEYS=EMPTY

# ------------------------------------------- OpenSRE (agent side) ----------
# vLLM is reached through the already-existing custom-openai provider.
# No provider code is needed — see docs/RECON.md §6.
LLM_PROVIDER=custom-openai
CUSTOM_OPENAI_BASE_URL=http://localhost:8000/v1
CUSTOM_OPENAI_API_KEY=EMPTY
CUSTOM_OPENAI_MODEL=opensre-reasoning
CUSTOM_OPENAI_REASONING_MODEL=opensre-reasoning
CUSTOM_OPENAI_CLASSIFICATION_MODEL=opensre-reasoning
CUSTOM_OPENAI_TOOLCALL_MODEL=opensre-reasoning
LLM_MAX_TOKENS=2048

# Hosted baseline, to judge the tool independently of the local model.
ANTHROPIC_API_KEY=

OPENSRE_NO_TELEMETRY=1
SENTRY_DSN=
ENV=development
# Local LLM: no need to mask outbound content.
OPENSRE_MASK_ENABLED=false

GRAFANA_INSTANCE_URL=http://localhost:3000
ALERTMANAGER_URL=http://localhost:9093
